{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "A tenant organization.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "adminEmail": { "type": "string", "format": "email" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "adminEmail", "created_at"]
    },
    "User": {
      "title": "User",
      "description": "User mapping to an organization.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "orgId": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "User"] }
      },
      "required": ["email", "orgId", "role"]
    },
    "Task": {
      "title": "Task",
      "description": "A task delegated to a team member.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "area": { "type": "string" },
        "task_type": { "type": "string" },
        "project": { "type": "string" },
        "task": { "type": "string" },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "assignee": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Completed"] },
        "feedbackStatus": { "type": "string", "enum": ["", "On Track", "Needs Input", "Stuck"] },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "progress": { "type": "number" },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "isCompleted": { "type": "boolean" }
            },
            "required": ["id", "title", "isCompleted"]
          }
        },
        "activityLog": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": { "type": "string" },
              "timestamp": { "type": "number" },
              "user": { "type": "string" }
            },
            "required": ["action", "timestamp", "user"]
          }
        },
        "notes": { "type": "string" },
        "flag": { "type": "string" },
        "feedback": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "area", "task_type", "task", "priority", "assignee", "status", "progress", "created_at", "updated_at"]
    },
    "Project": {
      "title": "Project",
      "description": "Project configuration.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "name", "description", "created_at"]
    },
    "TaskFeedback": {
      "title": "TaskFeedback",
      "description": "Feedback or chat messages for a specific task.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "user": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "user", "created_at"]
    },
    "Area": {
      "title": "Area",
      "description": "Functional department and its task types.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "task_types": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["orgId", "name", "task_types"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Team member for task assignment.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["User", "Manager"] },
        "area": { "type": "string" }
      },
      "required": ["orgId", "name", "email"]
    },
    "AdminInfo": {
      "title": "AdminInfo",
      "description": "General application administrative information.",
      "type": "object",
      "properties": {
        "developer_name": { "type": "string" },
        "company_name": { "type": "string" },
        "admin_email": { "type": "string", "format": "email" }
      }
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Tenant organizations."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User mapping for multi-tenancy."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks created in the system."
    },
    "/tasks/{taskId}/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/TaskFeedback" },
      "description": "Chat messages for a task"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Configurable projects."
    },
    "/areas/{areaId}": {
      "schema": { "$ref": "#/entities/Area" },
      "description": "Configurable areas and task types."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Configurable contacts list."
    },
    "/settings/admin": {
      "schema": { "$ref": "#/entities/AdminInfo" },
      "description": "Admin configuration."
    }
  }
}

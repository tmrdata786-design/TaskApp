rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function getAdminEmails() {
      let doc = get(/databases/$(database)/documents/settings/admin);
      return doc != null && 'admin_emails' in doc.data ? doc.data.admin_emails : [];
    }
    function isAdmin() { 
      return isSignedIn() && (request.auth.token.email == 'tmrdata786@gmail.com' || request.auth.token.email == 'tmrubberumarlatif@gmail.com' || request.auth.token.email in getAdminEmails()); 
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'description', 'created_at'])
        && data.name is string && data.name.size() <= 100
        && data.description is string && data.description.size() <= 1000;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['area', 'task_type', 'task', 'priority', 'assignee', 'status', 'progress', 'created_at', 'updated_at'])
        && data.area is string && data.area.size() <= 100
        && data.task_type is string && data.task_type.size() <= 100
        && data.task is string && data.task.size() <= 1000
        && data.priority in ['High', 'Medium', 'Low']
        && data.assignee is string && data.assignee.size() <= 100
        && data.status in ['Pending', 'In Progress', 'Completed']
        && (data.progress is number || data.progress is int || data.progress is float)
        && data.progress >= 0 && data.progress <= 1
        && data.get('project', '') is string
        && data.get('notes', '') is string
        && data.get('flag', '') is string
        && data.get('feedback', '') is string
        && data.get('start_date', '') is string
        && data.get('end_date', '') is string;
    }

    function isValidTaskFeedback(data) {
      return data.keys().hasAll(['text', 'user', 'created_at'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.user is string && data.user.size() > 0 && data.user.size() <= 100
        && data.created_at is string; // Let's simplify ISO string logic for now
    }

    match /tasks/{taskId} {
      // In a real application, restrict to specific company users
      // Here, we allow all signed-in users for simplicity
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().created_at == request.time
        && incoming().updated_at == request.time;
      allow update: if isSignedIn()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().created_at == existing().created_at
        && incoming().updated_at == request.time;
      allow delete: if isSignedIn();
      
      match /feedback/{feedbackId} {
        allow read, list: if isSignedIn();
        allow create: if isSignedIn() && isValidTaskFeedback(incoming()) && isValidId(feedbackId);
        allow update, delete: if isAdmin() && isValidId(feedbackId);
      }
    }

    match /areas/{areaId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && isValidId(areaId);
    }

    match /projects/{projectId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isSignedIn() && isValidId(projectId);
    }

    match /contacts/{contactId} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && isValidId(contactId);
    }

    match /accessRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && orgId.size() > 0 && incoming().keys().hasAll(['name', 'adminEmail']));
      allow delete: if isAdmin();
    }
    match /settings/admin {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
